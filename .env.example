# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

DJANGO_SECRET_KEY=replace-with-a-secure-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://inventory_user:replace-me@localhost:5432/inventory_db

# Persistent database connection settings.
# 0 is recommended for local development.
# 60 is a reasonable starting point for a production web process.
DATABASE_CONN_MAX_AGE=60
DATABASE_CONN_HEALTH_CHECKS=True

# ---------------------------------------------------------------------------
# Frontend / browser security
# ---------------------------------------------------------------------------

CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com

# ---------------------------------------------------------------------------
# HTTPS / security
# ---------------------------------------------------------------------------

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Set True only when your reverse proxy/load balancer correctly
# provides X-Forwarded-Proto.
USE_X_FORWARDED_PROTO=False

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

FRONTEND_BASE_URL=https://example.com
STAFF_INVITATION_EXPIRY_HOURS=48
